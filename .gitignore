# ============================================================
# Xcode — ユーザー固有設定・ビルド成果物のみ無視する
# .xcodeproj 本体はGit管理対象とする
# ============================================================

# ユーザー固有のXcodeワークスペース設定
xcuserdata/
*.xcuserstate

# ビルド成果物
DerivedData/
build/
*.ipa
*.dSYM.zip
*.dSYM
*.moved-aside

# ============================================================
# Swift Package Manager
# ============================================================

.build/
.swiftpm/xcode/

# Package.resolved はSPM使用時に追加する（再現ビルドのために管理対象にする場合もある）
# .package.resolved

# ============================================================
# CocoaPods（使用時のみ有効にする）
# ============================================================
# Pods/
# Podfile.lock

# ============================================================
# macOS
# ============================================================

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ============================================================
# 個人情報・センシティブデータ
# ============================================================

# HealthKitからエクスポートした生ファイル
export.xml
apple_health_export/

# 本番の生体データ（収集したままの状態のもの）
data/raw/
data/private/

# 実名とIDの対応表（外部公開しない）
data/subject_mapping.*

# 環境変数・シークレット
.env
*.secret
secrets/

# ============================================================
# IDE・エディタ
# ============================================================

.idea/
*.iml
.vscode/

# ============================================================
# その他
# ============================================================

*.log
*.bak
*.swp
*~

# ============================================================
# Xcode 共有スキーム（2026-11-04）
# ローカルで設定した開発用サーバーの URL・クライアントトークン（環境変数 MW_INSIGHT_*）を含むため、
# Git で共有しない。チームメンバーは自分のスキームに環境変数を設定する（docs/DEVICE_CONNECTION.md）。
# 対象はこのフォルダだけ（プロジェクト本体・他の共有設定は対象外）。
# ============================================================
MindWaveGraphic/MindWaveGraphic.xcodeproj/xcshareddata/xcschemes/

# 開発用サーバーの接続先・トークン（scripts/dev-device-setup.sh が作る。共有しない）
MindWaveGraphic/DevServer.local.xcconfig
