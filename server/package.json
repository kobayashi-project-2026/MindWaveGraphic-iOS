{
  "name": "mindwave-insight-server",
  "version": "0.1.0",
  "private": true,
  "description": "Mind Wave Graphic: OpenAI を安全に呼び出すための最小 API サーバー（Cloudflare Workers）",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
